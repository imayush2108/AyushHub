# =============================================================================
# AYUSH HUB — SECURE ADMIN CONFIGURATION
# =============================================================================
# 1. Sign up / log in to https://supabase.com and create a project (e.g. "ayush-hub").
# 2. In your Supabase Dashboard, go to Project Settings > API.
# 3. Copy "Project URL" and paste below as VITE_SUPABASE_URL.
# 4. Copy "anon / public" API Key and paste below as VITE_SUPABASE_ANON_KEY.
# 
# NOTE: The Anon key is designed for client-side use. NEVER expose your
# "service_role" secret key in frontend code or repository secrets!
# =============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Optional: Administrator Email address for auxiliary verification
# (The primary authorization check verifies against the database table 'admin_profiles')
VITE_ADMIN_EMAIL=your-personal-email@domain.com
